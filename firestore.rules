rules_version = '2';

// 誰是臥底 · Firestore 安全規則
// - 建立房間：任何登入者（含匿名）都可以
// - 主持人：Google 登入且在 admin/hosts 白名單，才能編輯題目、開始 / 揭曉 / 管理組別
// - 玩家 / 投影幕：匿名登入
// - 各組答案（words）只有該組組員與主持人讀得到，別組看不到
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // 主持人白名單存在 Firestore 的 admin/hosts 文件（欄位 emails: [...]），
    // 只能在 Firebase Console 手動編輯，前端讀不到，也不會出現在 git 裡。
    function isAllowedHost() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admin/hosts)
        && request.auth.token.email in get(/databases/$(database)/documents/admin/hosts).data.emails;
    }

    // admin/hosts：只有白名單主持人自己能讀（主持台用來確認身分），任何人都不能從前端寫
    match /admin/{docId} {
      allow get: if docId == 'hosts' && isAllowedHost();
      allow list, write: if false;
    }

    // 題庫（題目設計頁）：只有白名單主持人可讀寫，玩家讀不到題目
    match /bank/{docId} {
      allow read: if isAllowedHost();
      allow write: if isAllowedHost() && docId == 'questions'
        && request.resource.data.rounds is list
        && request.resource.data.rounds.size() <= 10;
    }

    // 玩家：名字 + 目前所在的桌（table）。所有登入者可讀（顯示名單），只有本人可寫。
    // 換桌只能在「原本的桌」與「新的桌」都在待命時進行，避免遊戲中換桌偷看別桌答案。
    function tableIdle(t) {
      return t == null
        || !exists(/databases/$(database)/documents/rooms/$(t))
        || get(/databases/$(database)/documents/rooms/$(t)).data.status == 'lobby';
    }
    function validPlayer() {
      return request.resource.data.keys().hasOnly(['name', 'updatedAt', 'table'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 12
        && request.resource.data.updatedAt == request.time
        && (request.resource.data.get('table', null) == null || request.resource.data.table is string);
    }
    match /players/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid && validPlayer()
        && tableIdle(request.resource.data.get('table', null));
      allow update: if signedIn() && request.auth.uid == uid && validPlayer()
        && (request.resource.data.get('table', null) == resource.data.get('table', null)
            || (tableIdle(resource.data.get('table', null)) && tableIdle(request.resource.data.get('table', null))));
    }

    // 全場狀態（投影幕倒數用）：所有人可讀，只有白名單主持人可寫
    match /game/{docId} {
      allow read: if signedIn();
      allow write: if isAllowedHost();
    }

    // 白名單主持人可以操控「任何」房間
    function isHost(code) { return isAllowedHost(); }

    match /rooms/{code} {
      allow read: if signedIn();

      // 任何人（含匿名登入的投影幕 / 玩家）都可以建立房間，但只能建立「大廳」狀態的空房間
      allow create: if signedIn()
        && code.matches('^[0-9]{4}$')
        && request.resource.data.keys().hasOnly(['name', 'createdBy', 'status', 'round', 'duration', 'roundId', 'startedAt', 'reveal', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 12
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'lobby'
        && request.resource.data.round == 0
        && request.resource.data.duration == 180
        && request.resource.data.roundId == null
        && request.resource.data.startedAt == null
        && request.resource.data.reveal == null
        && request.resource.data.createdAt == request.time;

      // 開始 / 揭曉 / 回大廳 等流程：只有白名單主持人
      allow update: if isAllowedHost()
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isAllowedHost();

      // 本輪臥底：只有主持人
      match /private/{docId} { allow read, write: if isHost(code); }

      function inLobby() { return get(/databases/$(database)/documents/rooms/$(code)).data.status == 'lobby'; }
      function myTable() { return get(/databases/$(database)/documents/players/$(request.auth.uid)).data.get('table', null); }
      function myTableAfter() { return getAfter(/databases/$(database)/documents/players/$(request.auth.uid)).data.get('table', null); }

      // 桌上的玩家：加入 / 離開只能在待命狀態，且必須和 players/{uid}.table 一致（一人只在一桌）
      match /members/{uid} {
        allow read: if signedIn();
        allow create: if signedIn() && request.auth.uid == uid && inLobby()
          && myTableAfter() == code
          && request.resource.data.keys().hasOnly(['joinedAt', 'eliminated'])
          && request.resource.data.joinedAt == request.time
          && request.resource.data.eliminated == false;
        allow update: if isHost(code);   // 淘汰 / 復活
        allow delete: if isHost(code) || (signedIn() && request.auth.uid == uid && inLobby());
      }

      // 每位玩家自己的答案：只有本人（且目前在這一桌）與主持人讀得到
      match /words/{uid} {
        allow read: if isHost(code) || (signedIn() && request.auth.uid == uid && myTable() == code);
        allow write: if isHost(code);
      }
    }
  }
}
